# URL Frappe backend — dùng bởi Next.js server-side để proxy (next.config.ts)
# Dùng hostname đúng để bench route đúng site, nhưng qua port 8000 trực tiếp (không qua Cloudflare)
FRAPPE_URL=https://yoursite.com

# Client-side 
NEXT_PUBLIC_FRAPPE_URL=https://yoursite.com

# Optional VIETMAP tilemap key. Restrict this public key to the deployed domain.
# Without a key, label-free satellite and terrain backgrounds remain available.
NEXT_PUBLIC_VIETMAP_TILEMAP_API_KEY=

# Optional approved XYZ basemap. When set, this takes priority over VIETMAP/fallback imagery.
# The URL must be reviewed for licensing and sovereignty before production use.
NEXT_PUBLIC_GIS_BASEMAP_URL=
NEXT_PUBLIC_GIS_BASEMAP_ATTRIBUTION=
